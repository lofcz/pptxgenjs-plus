{
	"name": "pptxgenjs-plus-jsx",
	"version": "4.3.1",
	"description": "JSX runtime for building PowerPoint presentations with pptxgenjs-plus",
	"homepage": "https://github.com/lofcz/pptxgenjs-plus/tree/next/packages/pptxgenjs-jsx#readme",
	"bugs": {
		"url": "https://github.com/lofcz/pptxgenjs-plus/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Matěj Lofcz Štágl",
		"url": "https://github.com/lofcz"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lofcz/pptxgenjs-plus.git",
		"directory": "packages/pptxgenjs-jsx"
	},
	"keywords": [
		"pptx",
		"pptxgenjs",
		"pptxgenjs-plus",
		"powerpoint",
		"jsx",
		"typescript",
		"presentation",
		"slides"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./jsx-runtime": {
			"types": "./dist/jsx-runtime.d.ts",
			"default": "./dist/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/jsx-dev-runtime.d.ts",
			"default": "./dist/jsx-dev-runtime.js"
		},
		"./render": {
			"types": "./dist/render.d.ts",
			"default": "./dist/render.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.3.0",
		"node": ">=24"
	},
	"dependencies": {
		"@lofcz/mathlive": "^0.110.6",
		"markdown-it": "^14.1.0",
		"mathml2omml-plus": "^0.6.4",
		"pptxgenjs-plus": "file:../.."
	},
	"devDependencies": {
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.2.0",
		"typescript": "^6.0.3"
	}
}
